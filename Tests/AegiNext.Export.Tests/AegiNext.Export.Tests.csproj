<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AegiNext.Export.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AegiNext.Export.TestHost/AegiNext.Export.TestHost.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/AegiNext.Export/AegiNext.Export.csproj" />
    <ProjectReference Include="../../src/AegiNext.Application/AegiNext.Application.csproj" />
    <ProjectReference Include="../../src/AegiNext.SubtitleFormats/AegiNext.SubtitleFormats.csproj" />
    <ProjectReference Include="../../src/AegiNext.Media/AegiNext.Media.csproj" />
    <Using Include="Xunit" />
    <None Include="../AegiNext.Rendering.Tests/Fixtures/NotoSans.ttf" Link="Fixtures/NotoSans.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyExportCancellationTestHost" AfterTargets="Build">
    <MSBuild Projects="../AegiNext.Export.TestHost/AegiNext.Export.TestHost.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_ExportCancellationHostTarget" />
    </MSBuild>
    <ItemGroup>
      <_ExportCancellationHostFile Include="$([System.IO.Path]::GetDirectoryName('%(_ExportCancellationHostTarget.Identity)'))/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExportCancellationHostFile)"
          DestinationFiles="@(_ExportCancellationHostFile->'$(TargetDir)ExportTestHost/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Import Project="../Shared/Media/MediaFixtures.props" />
</Project>
