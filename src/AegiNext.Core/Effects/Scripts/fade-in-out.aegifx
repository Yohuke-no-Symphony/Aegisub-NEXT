# 固定淡入、随 Clip 时长伸缩的保持段、固定淡出。
effect "fade-in-out" version 3
short-clip compress

var duration = 300ms label "Duration" suggest ["Fast":150ms, "Normal":300ms, "Slow":600ms]

scope whole current
    segment enter fixed duration
        at 0 opacity 0 ease-out
        at 1 opacity base
    end

    segment stay flex 1
        at 0 opacity base hold
        at 1 opacity base
    end

    segment exit fixed duration
        at 0 opacity base ease-in
        at 1 opacity 0
    end
end
