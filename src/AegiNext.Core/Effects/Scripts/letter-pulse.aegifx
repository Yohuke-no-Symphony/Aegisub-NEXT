# Each grapheme grows once over a 300ms complete period, then rests.
effect "letter-pulse" version 3
short-clip compress

var duration = 150ms label "One-way duration"
var stagger = 60ms label "Stagger"
var scale = vec2(1.25, 1.25) label "Peak scale"

scope letters current
    unit grapheme
    stagger stagger
    segment pulse fixed duration pingpong
        at 0 scale base ease-in-out
        at 1 scale factor(scale)
    end
    segment rest flex 1
    end
end
