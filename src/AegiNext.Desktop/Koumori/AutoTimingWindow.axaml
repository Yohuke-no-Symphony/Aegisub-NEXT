<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:AegiNext.Desktop.Controls.Common" xmlns:koumori="using:AegiNext.Desktop.Koumori"
        x:Class="AegiNext.Desktop.Koumori.AutoTimingWindow" x:DataType="koumori:AutoTimingViewModel"
        Title="{Loc Key=Koumori.Title}" Classes="business-surface" Width="800" Height="620"
        MinWidth="800" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Separator.timing-toolbar-separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource PreviewBorder}" />
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <common:WindowTitleBar Name="AutoTimingTitleBar" Title="{Loc Key=Koumori.Title}" />
    <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,*" RowSpacing="16">
      <StackPanel Spacing="8">
        <Grid Name="TimingToolbar" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button Name="AnalyzeButton" Command="{Binding AnalysisCommand}" VerticalAlignment="Stretch"
                  AutomationProperties.Name="{Binding AnalysisLabel}">
            <common:IconText Text="{Binding AnalysisLabel}" IconKey="{Binding AnalysisIcon}" />
          </Button>
          <Separator Grid.Column="1" Classes="timing-toolbar-separator" />
          <Button Name="SelectAllButton" Grid.Column="2" Command="{Binding SelectAllCommand}"
                  IsEnabled="{Binding CanEdit}" VerticalAlignment="Stretch">
            <common:IconText Text="{Loc Key=Koumori.SelectAll}" IconKey="SelectAll" />
          </Button>
          <Button Name="SelectNoneButton" Grid.Column="3" Command="{Binding SelectNoneCommand}"
                  IsEnabled="{Binding CanEdit}" VerticalAlignment="Stretch">
            <common:IconText Text="{Loc Key=Koumori.SelectNone}" IconKey="SelectNone" />
          </Button>
          <Button Name="AuditionButton" Grid.Column="4" Command="{Binding AuditionCommand}" VerticalAlignment="Stretch">
            <common:IconText Text="{Loc Key=Koumori.Audition}" IconKey="Play" />
          </Button>
          <Separator Grid.Column="6" Classes="timing-toolbar-separator" />
          <Button Name="ApplyTimingButton" Grid.Column="7" Command="{Binding ApplyCommand}"
                  Classes="accent" VerticalAlignment="Stretch">
            <common:IconText Text="{Loc Key=Koumori.Apply}" IconKey="AddTrack" />
          </Button>
        </Grid>
        <ProgressBar Name="AnalysisProgress" Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
        <TextBlock Name="AnalysisError" Text="{Binding Error}" IsVisible="{Binding HasError}"
                   Foreground="{DynamicResource PreviewError}" TextWrapping="Wrap" MaxHeight="90" />
      </StackPanel>
      <Border Name="TimingResults" Grid.Row="1" BorderBrush="{DynamicResource PreviewBorder}"
              BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource PreviewBorder}"
                  BorderThickness="0,0,0,1">
            <Grid Width="{Binding #TimingRows.Scroll.Viewport.Width, FallbackValue=0}" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="48,*,*,80" Margin="12,8" ColumnSpacing="12">
                <TextBlock Classes="field" Text="{Loc Key=Koumori.Use}" />
                <TextBlock Name="StartColumnHeader" Classes="field" Grid.Column="1" Text="{Loc Key=Koumori.Start}" />
                <TextBlock Name="EndColumnHeader" Classes="field" Grid.Column="2" Text="{Loc Key=Koumori.End}" />
                <TextBlock Classes="field" Grid.Column="3" Text="{Loc Key=Koumori.Score}" />
              </Grid>
            </Grid>
          </Border>
          <ListBox Name="TimingRows" Grid.Row="1" ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="koumori:KoumoriPreviewRow">
                <Grid ColumnDefinitions="48,*,*,80" ColumnSpacing="12" Margin="0,2">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Loc Key=Koumori.Use}" />
                  <TextBox Name="StartTimeInput" Grid.Column="1" Text="{Binding StartText, Mode=TwoWay}"
                           AutomationProperties.Name="{Loc Key=Koumori.Start}" />
                  <TextBox Name="EndTimeInput" Grid.Column="2" Text="{Binding EndText, Mode=TwoWay}"
                           AutomationProperties.Name="{Loc Key=Koumori.End}" />
                  <TextBlock Grid.Column="3" Text="{Binding ScoreText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
