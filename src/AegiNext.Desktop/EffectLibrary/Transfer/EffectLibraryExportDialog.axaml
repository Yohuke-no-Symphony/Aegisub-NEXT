<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:AegiNext.Desktop.Controls.Common"
        xmlns:transfer="using:AegiNext.Desktop.EffectLibrary.Transfer"
        x:Class="AegiNext.Desktop.EffectLibrary.Transfer.EffectLibraryExportDialog"
        x:DataType="transfer:EffectLibraryExportDialogViewModel"
        Classes="business-surface" Title="{Loc Key=EffectLibrary.ExportDialogTitle}"
        Width="760" Height="720" MinWidth="600" MinHeight="680" CanResize="True"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PreviewBackground}">
  <Grid RowDefinitions="Auto,*">
    <common:WindowTitleBar Name="EffectLibraryExportTitleBar" Title="{Loc Key=EffectLibrary.ExportDialogTitle}" />
    <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Classes="heading" FontSize="20" Text="{Loc Key=EffectLibrary.ExportDialogTitle}" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Name="EffectLibraryExportSearch" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{Loc Key=EffectLibrary.ExportSearch}" AutomationProperties.Name="{Loc Key=EffectLibrary.ExportSearch}"
                 IsEnabled="{Binding CanInteract}">
          <TextBox.InnerRightContent>
            <Button Name="EffectLibraryExportClearSearch" Classes="icon-button" Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearchText}" Focusable="False" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="{Loc Key=EffectLibrary.ExportClearSearch}" AutomationProperties.Name="{Loc Key=EffectLibrary.ExportClearSearch}">
              <common:IconText IconKey="Clear" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <Button Name="EffectLibraryExportSelectAll" Grid.Column="1" Classes="icon-button" VerticalAlignment="Center"
                Command="{Binding SelectAllCommand}" ToolTip.Tip="{Loc Key=EffectLibrary.ExportSelectAll}"
                AutomationProperties.Name="{Loc Key=EffectLibrary.ExportSelectAll}">
          <common:IconText IconKey="SelectAll" />
        </Button>
        <Button Name="EffectLibraryExportSelectNone" Grid.Column="2" Classes="icon-button" VerticalAlignment="Center"
                Command="{Binding ClearSelectionCommand}" ToolTip.Tip="{Loc Key=EffectLibrary.ExportSelectNone}"
                AutomationProperties.Name="{Loc Key=EffectLibrary.ExportSelectNone}">
          <common:IconText IconKey="SelectNone" />
        </Button>
      </Grid>
      <Border Grid.Row="2" Classes="card" Padding="8">
        <Grid RowDefinitions="*,Auto">
          <TreeView Name="EffectLibraryExportTree" ItemsSource="{Binding Roots}" Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanInteract}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="transfer:EffectLibraryExportNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="transfer:EffectLibraryExportNode" ItemsSource="{Binding Children}">
                <CheckBox Name="EffectLibraryExportNodeCheckBox" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelect}" IsThreeState="False" HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Classes="field" IsVisible="{Binding HasDetails}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </CheckBox>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <TextBlock Grid.Row="1" Text="{Loc Key=EffectLibrary.ExportNoMatches}" IsVisible="{Binding HasNoMatches}" Classes="field" TextWrapping="Wrap" Margin="8" />
          <TextBlock Grid.Row="1" Text="{Loc Key=EffectLibrary.ExportEmptyLibrary}" IsVisible="{Binding IsEmpty}" Classes="field" TextWrapping="Wrap" Margin="8" />
        </Grid>
      </Border>
      <TextBlock Name="EffectLibraryExportSelectionSummary" Grid.Row="3" Text="{Binding SelectionSummary}" Classes="field" TextWrapping="Wrap" />
      <common:PropertyRowControl Grid.Row="4" Header="{Loc Key=EffectLibrary.ExportFormat}" SeparatorThickness="0">
        <ComboBox Name="EffectLibraryExportDialogFormat" IsEnabled="{Binding CanInteract}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="transfer:EffectLibraryExportFormatChoice">
              <TextBlock Text="{Binding Text}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </common:PropertyRowControl>
      <TextBlock Grid.Row="5" Text="{Loc Key=EffectLibrary.SourceExportHint}" IsVisible="{Binding IsSourceFormat}" Classes="field" TextWrapping="Wrap" />
      <StackPanel Grid.Row="6" Spacing="8">
        <TextBlock Text="{Loc Key=EffectLibrary.ExportInProgress}" IsVisible="{Binding IsBusy}" Classes="field" />
        <ScrollViewer Name="EffectLibraryExportErrorScroll" MaxHeight="80" IsVisible="{Binding HasError}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <TextBlock Name="EffectLibraryExportDialogError" Text="{Binding Error}"
                     Foreground="{DynamicResource SettingsError}" TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>
      <Grid Grid.Row="7" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
        <Button Name="EffectLibraryExportCancel" Content="{Loc Key=Workbench.Cancel}" Click="OnCancel" VerticalAlignment="Stretch" />
        <Button Name="EffectLibraryExportSelected" Grid.Column="1" Command="{Binding ExportSelectedCommand}"
                Content="{Loc Key=EffectLibrary.ExportSelected}" Classes="accent" VerticalAlignment="Stretch" />
      </Grid>
    </Grid>
  </Grid>
</Window>
