<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AegiNext.Desktop.Controls" xmlns:editing="using:AegiNext.Desktop.Editing"
    xmlns:vm="using:AegiNext.Desktop.Panels.Preview" xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:DataType="vm:PreviewPanelViewModel"
    x:Class="AegiNext.Desktop.Panels.Preview.PreviewPanelView" Classes="business-surface">
<Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="0" CornerRadius="{DynamicResource WorkbenchPanelCornerRadius}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Margin="8,4" Spacing="4">
            <ComboBox Name="CanvasToolCombo" MinWidth="120" MaxWidth="200" ItemsSource="{Binding CanvasTools}"
                      SelectedItem="{Binding SelectedCanvasTool, Mode=TwoWay}" AutomationProperties.Name="{Loc Key=Preview.SelectGraphic}" />
            <Button Name="SubtitleBackgroundButton" Classes="icon-button" IsEnabled="{Binding CanCreateSubtitleBackground}"
                    ToolTip.Tip="{Loc Key=Preview.CreateSubtitleBackground}" AutomationProperties.Name="{Loc Key=Preview.CreateSubtitleBackground}" />
            <Button Name="StraightSegmentButton" Classes="icon-button" IsVisible="{Binding IsShapePathEditing}"
                    ToolTip.Tip="{Loc Key=Preview.StraightSegment}" AutomationProperties.Name="{Loc Key=Preview.StraightSegment}" />
            <Button Name="CurveSegmentButton" Classes="icon-button" IsVisible="{Binding IsShapePathEditing}"
                    ToolTip.Tip="{Loc Key=Preview.CurveSegment}" AutomationProperties.Name="{Loc Key=Preview.CurveSegment}" />
            <Button Name="CloseShapePathButton" Classes="icon-button" IsVisible="{Binding IsShapePathEditing}"
                    ToolTip.Tip="{Loc Key=Preview.ToggleClosedPath}" AutomationProperties.Name="{Loc Key=Preview.ToggleClosedPath}" />
            <Button Name="FinishShapePathButton" Classes="icon-button" IsVisible="{Binding IsShapePathCreation}"
                    ToolTip.Tip="{Loc Key=Preview.FinishPath}" AutomationProperties.Name="{Loc Key=Preview.FinishPath}" />
          </StackPanel>
          <Grid Grid.Row="1" Name="VideoSurface" Background="#080A0E" ClipToBounds="True" ToolTip.Tip="{Binding FileTitle}" DragDrop.AllowDrop="True">
            <controls:EffectCanvasControl Name="EffectCanvas" />
            <StackPanel Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding ShowEmptyHint, Mode=OneWay}" IsHitTestVisible="False">
              <TextBlock Classes="ui-icon" Text="▷" FontSize="42" Foreground="#7C8AA6" HorizontalAlignment="Center" />
              <TextBlock Name="EmptyLabel" Foreground="#A5ADBD" FontSize="13" Text="{Binding EmptyLabel, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar Name="OpeningProgress" IsIndeterminate="True" Height="3" VerticalAlignment="Top" IsVisible="{Binding IsOpening, Mode=OneWay}" />
            <Border Name="CatchingUpOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="12,6" CornerRadius="6" Background="{DynamicResource PreviewSurface}"
                    BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1" IsHitTestVisible="False"
                    IsVisible="{Binding IsCatchingUp, Mode=OneWay}">
              <TextBlock Classes="field" Text="{Loc Key=Preview.CatchingUp}" />
            </Border>
            <Grid Name="PreviewOptions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
            <ComboBox Name="QualityCombo" Height="{StaticResource WorkbenchControlHeight}" Padding="6,2" FontSize="11" MaxWidth="160"
                      VerticalContentAlignment="Center" ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                      ToolTip.Tip="{Binding QualityLabel}" AutomationProperties.Name="{Binding QualityLabel}" />
            <Border Name="ModeBadge" Grid.Column="1" Height="{StaticResource WorkbenchControlHeight}" Padding="7,0" CornerRadius="5"
                    Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1" IsHitTestVisible="False">
              <TextBlock Name="ModeLabel" Classes="field" Text="SDR" FontSize="11" VerticalAlignment="Center" />
            </Border>
            </Grid>
          </Grid>
          <Grid Grid.Row="2" Margin="12,6" RowDefinitions="Auto,Auto" RowSpacing="2">
            <Grid.Resources>
              <GridLength x:Key="SliderPreContentMargin">2</GridLength>
              <GridLength x:Key="SliderPostContentMargin">2</GridLength>
              <sys:Double x:Key="SliderHorizontalHeight">24</sys:Double>
            </Grid.Resources>
            <Slider Name="PositionSlider" Theme="{StaticResource WorkbenchTransportSliderTheme}" Minimum="0" Maximum="{Binding Duration}" IsEnabled="{Binding CanSeek}" Value="{Binding Position, Mode=OneWay}" />
            <Grid Name="TransportRow" Grid.Row="1" Height="32" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Button Name="PlayButton" Classes="icon-button" IsEnabled="{Binding CanPlay}" Command="{Binding PlayCommand}"
                      ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}" />
              <TextBlock Name="TimeLabel" Grid.Column="1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TimeLabel}" Text="{Binding TimeLabel, Mode=OneWay}" />
              <Grid Grid.Column="2" ColumnDefinitions="32,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                <ToggleButton Name="MuteButton" Classes="icon-button" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                              ToolTip.Tip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}" />
                <Slider Name="VolumeSlider" Theme="{StaticResource WorkbenchTransportSliderTheme}" Grid.Column="1" Minimum="0" Maximum="1" Width="76"
                        VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}"
                        ToolTip.Tip="{Binding VolumeLabel}" AutomationProperties.Name="{Binding VolumeLabel}" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      
</UserControl>
