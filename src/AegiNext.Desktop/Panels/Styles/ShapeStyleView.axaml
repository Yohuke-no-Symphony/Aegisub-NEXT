<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="using:AegiNext.Desktop.Panels.Styles" xmlns:controls="using:AegiNext.Desktop.Controls"
             x:Class="AegiNext.Desktop.Panels.Styles.ShapeStyleView" x:DataType="styles:ShapeStyleViewModel">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="8">
      <TextBlock Classes="field" Text="{Loc Key=Workbench.Size}" />
      <controls:VectorDraftInput Name="ShapeSizeInput" XFieldKey="LayerWidthInput" YFieldKey="LayerHeightInput"
          XTextBinding="{Binding Width.RawText, Mode=TwoWay}" YTextBinding="{Binding Height.RawText, Mode=TwoWay}"
          XBinding="{Binding Width.Value, Mode=TwoWay}" YBinding="{Binding Height.Value, Mode=TwoWay}" Minimum="1" Maximum="32768" />
      <TextBlock Classes="field" Text="{Loc Key=Workbench.Fill}" />
      <controls:ColorDraftInput Name="FillPicker" Draft="{Binding FillDraft}" />
      <TextBlock Classes="field" Text="{Loc Key=Workbench.Stroke}" />
      <controls:ColorDraftInput Name="StrokePicker" Draft="{Binding StrokeDraft}" />
      <controls:NumericDragLabel Input="{Binding #StrokeWidthInput}" Classes="field" Text="{Loc Key=Workbench.StrokeWidth}" />
      <controls:NumericDraftInput Name="StrokeWidthInput" RawText="{Binding StrokeWidth.RawText, Mode=TwoWay}"
          Value="{Binding StrokeWidth.Value, Mode=TwoWay}" Minimum="0" Maximum="512" IsEnabled="{Binding CanEditStrokeWidth}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
