<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="using:AegiNext.Desktop.Panels.Styles"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="AegiNext.Desktop.Panels.Styles.StylesPanelView" x:DataType="styles:StylesPanelViewModel"
             Classes="business-surface">
  <Grid RowDefinitions="Auto,*">
    <TextBlock Name="StyleSelectionLabel" Margin="8,4" Classes="field" TextWrapping="Wrap"
               Text="{Binding SelectionLabel}"
               IsVisible="{Binding SelectionLabel, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
    <ContentControl Grid.Row="1" Name="StyleEditorHost" />
  </Grid>
</UserControl>
