<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlsCommon="using:AegiNext.Desktop.Controls.Common"
             xmlns:controls="using:AegiNext.Desktop.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:core="clr-namespace:AegiNext.Core.Projects;assembly=AegiNext.Core"
             xmlns:workspace="using:AegiNext.Desktop.Workspace"
             xmlns:vm="using:AegiNext.Desktop.Panels.Effects" x:DataType="vm:EffectsPanelViewModel"
             x:Class="AegiNext.Desktop.Panels.Effects.EffectsPanelView" Classes="business-surface">
  <Grid>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="EffectPanel" Margin="4" Spacing="6">
      <TextBlock Name="ValidationMessage" Text="{Binding ValidationError}"
                 IsVisible="{Binding ValidationError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                 Foreground="Tomato" TextWrapping="Wrap" />
      <TextBlock Name="EditingTarget" Text="{Binding EditTargetLabel}" IsVisible="{Binding EditTargetLabel, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="field" />
      <controlsCommon:PropertyRowControl Name="EffectInstancesRow" Header="{Loc Key=Workbench.EffectInstances}" IsVisible="{Binding HasSelectedEffectInstance}">
        <ComboBox Name="EffectInstancesCombo" ItemsSource="{Binding EffectInstances}" SelectedItem="{Binding SelectedEffectInstance, Mode=TwoWay}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="core:EffectInstance"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </controlsCommon:PropertyRowControl>
      <StackPanel Name="EffectInstanceInspector" IsVisible="{Binding HasSelectedEffectInstance}" Spacing="6">
        <CheckBox Name="EffectInstanceEnabledCheck" Content="{Loc Key=Workbench.EffectInstanceEnabled}" IsChecked="{Binding IsInstanceEnabled, Mode=OneWay}" />
        <controlsCommon:PropertyRowControl Header="{Loc Key=Workbench.EffectInstanceStart}">
          <controls:NumericDraftInput Name="InstanceStartInput" RawText="{Binding InstanceStart.RawText, Mode=TwoWay}" Value="{Binding InstanceStart.Value, Mode=TwoWay}" Minimum="{Binding InstanceTimeMinimum}" Maximum="{Binding InstanceTimeMaximum}" Increment="0.1" />
        </controlsCommon:PropertyRowControl>
        <controlsCommon:PropertyRowControl Header="{Loc Key=Workbench.EffectInstanceEnd}">
          <controls:NumericDraftInput Name="InstanceEndInput" RawText="{Binding InstanceEnd.RawText, Mode=TwoWay}" Value="{Binding InstanceEnd.Value, Mode=TwoWay}" Minimum="{Binding InstanceTimeMinimum}" Maximum="{Binding InstanceTimeMaximum}" Increment="0.1" />
        </controlsCommon:PropertyRowControl>
        <controls:EffectScriptParameterEditor Name="InstanceParameterEditor" Drafts="{Binding InstanceParameters}" />
        <WrapPanel>
          <Button Name="ResetEffectParametersButton" Content="{Loc Key=Workbench.EffectInstanceResetParameters}" Command="{Binding ResetInstanceParametersCommand}" />
          <Button Name="RemoveEffectInstanceButton" Content="{Loc Key=Workbench.EffectInstanceRemove}" Command="{Binding RemoveInstanceCommand}" />
        </WrapPanel>
      </StackPanel>
      <StackPanel Name="ManualEffectProperties" IsVisible="{Binding !HasSelectedEffectInstance}" Spacing="6">
      <controlsCommon:PropertyRowControl Name="EffectScopeRow" Header="{Loc Key=Workbench.EffectScope}">
        <ComboBox Name="EffectScopeCombo" ItemsSource="{Binding Scopes}"
            SelectedItem="{Binding SelectedScope, Mode=TwoWay}" IsEnabled="{Binding CanEditTextScope}" HorizontalAlignment="Stretch" />
      </controlsCommon:PropertyRowControl>
      <controlsCommon:PropertyRowControl Name="EffectStateRow" Header="{Loc Key=Workbench.VisualState}" IsVisible="{Binding CanEditTextScope}">
        <ComboBox Name="EffectStateCombo" ItemsSource="{Binding States}"
            SelectedItem="{Binding SelectedState, Mode=TwoWay}" HorizontalAlignment="Stretch" />
      </controlsCommon:PropertyRowControl>
      <Grid Name="RangeActions" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
        <Button Name="CreateAnimationRangeButton" Grid.Column="0" Command="{Binding CreateRangeCommand}" IsEnabled="{Binding CanCreateRange}"
            IsVisible="{Binding CanEditTextScope}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            ToolTip.Tip="{Loc Key=Workbench.CreateAnimationRange}" AutomationProperties.Name="{Loc Key=Workbench.CreateAnimationRange}">
          <TextBlock Text="{Loc Key=Workbench.CreateAnimationRange}" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
        <Button Name="DeleteAnimationRangeButton" Grid.Column="1" Command="{Binding DeleteRangeCommand}" IsEnabled="{Binding CanManageRange}"
            IsVisible="{Binding CanEditTextScope}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            ToolTip.Tip="{Loc Key=Workbench.DeleteAnimationRange}" AutomationProperties.Name="{Loc Key=Workbench.DeleteAnimationRange}">
          <TextBlock Text="{Loc Key=Workbench.DeleteAnimationRange}" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
        <Button Name="ResetPositionButton" Grid.Column="3" IsVisible="{Binding IsWholeLayerTarget}" Command="{Binding ResetPositionCommand}"
            IsEnabled="{Binding CanResetPosition}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            ToolTip.Tip="{Loc Key=Workbench.ResetPosition}" AutomationProperties.Name="{Loc Key=Workbench.ResetPosition}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <controlsCommon:IconText IconKey="ResetPosition" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Loc Key=Workbench.ResetPosition}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>
      <controlsCommon:PropertySection Name="TransformCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryTransform}" IsExpanded="{Binding TransformExpanded, Mode=TwoWay}" IsEnabled="{Binding CanEditTargetTransform}">
        <StackPanel>
          <controls:AnimationPropertyRowControl Name="PositionRow" Label="{Binding PositionLabel}" IsVector="True"
              IsVisible="{Binding CanEditTargetTransform}" X="{Binding PositionXDraft}" Y="{Binding PositionYDraft}"
              VectorInputName="PositionInput" XFieldKey="PositionXInput" YFieldKey="PositionYInput" XInputName="PositionXInput" YInputName="PositionYInput"
              Minimum="-2000032768" Maximum="2000032768" CanEdit="{Binding CanEditPosition}" EditingHint="{Binding PositionEditingHint}"
              IsAnimated="{Binding IsPositionAnimated}" CanAddKeyframe="{Binding CanAddPositionKeyframe}" CanReset="{Binding CanResetPositionAnimation}"
              CommandParameter="{x:Static core:AnimationProperty.POSITION}"
              AnimationOptionsCommand="{Binding AnimationOptionsPropertyCommand}" AnimationOptionsHint="{Loc Key=Workbench.PositionAnimationOptions}"
              AddKeyframeCommand="{Binding AddPropertyKeyframeCommand}" KeyframeButtonName="PositionKeyframeButton" KeyframeHint="{Loc Key=Workbench.Keyframe}"
              ResetCommand="{Binding ResetPropertyCommand}" ResetButtonName="PositionResetAnimationButton" ResetHint="{Loc Key=Workbench.ResetProperty}"
              Error="{Binding ValidationError}" InvalidFieldKey="{Binding InvalidFieldKey}" />
          <controls:AnimationPropertyRowControl Name="ScaleRow" Label="{Loc Key=Workbench.ScaleVector}" IsVector="True"
              X="{Binding ScaleXDraft}" Y="{Binding ScaleYDraft}" VectorInputName="ScaleInput"
              XFieldKey="ScaleXInput" YFieldKey="ScaleYInput" XInputName="ScaleXInput" YInputName="ScaleYInput"
              Minimum="{x:Static vm:EffectsPanelViewModel.ScaleMinimum}" Maximum="{x:Static vm:EffectsPanelViewModel.ScaleMaximum}" Increment="0.01"
              CanEdit="{Binding CanEditScale}" EditingHint="{Binding ScaleEditingHint}" IsAnimated="{Binding IsScaleAnimated}"
              CanAddKeyframe="{Binding CanAddScaleKeyframe}" CanReset="{Binding CanResetScaleAnimation}"
              CommandParameter="{x:Static core:AnimationProperty.SCALE}"
              AnimationOptionsCommand="{Binding AnimationOptionsPropertyCommand}" AnimationOptionsHint="{Loc Key=Workbench.ScaleAnimationOptions}"
              AddKeyframeCommand="{Binding AddPropertyKeyframeCommand}" KeyframeHint="{Loc Key=Workbench.Keyframe}"
              ResetCommand="{Binding ResetPropertyCommand}" ResetHint="{Loc Key=Workbench.ResetProperty}"
              Error="{Binding ValidationError}" InvalidFieldKey="{Binding InvalidFieldKey}" />
          <ItemsControl ItemsSource="{Binding RotationRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding PerspectiveRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="TypographyCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryTypography}" IsExpanded="{Binding TypographyExpanded, Mode=TwoWay}">
        <ItemsControl ItemsSource="{Binding TypographyRows}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="FillCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryFill}" IsExpanded="{Binding FillExpanded, Mode=TwoWay}">
        <ItemsControl ItemsSource="{Binding FillRows}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="StrokeCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryStroke}" IsExpanded="{Binding StrokeExpanded, Mode=TwoWay}">
        <ItemsControl ItemsSource="{Binding StrokeRows}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="ShadowCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryShadow}" IsExpanded="{Binding ShadowExpanded, Mode=TwoWay}">
        <ItemsControl ItemsSource="{Binding ShadowRows}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="CompositeCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryComposite}" IsExpanded="{Binding CompositeExpanded, Mode=TwoWay}" IsVisible="{Binding IsWholeLayerTarget}">
        <StackPanel>
          <controls:AnimationPropertyRowControl Name="OpacityRow" Label="{Loc Key=Workbench.Opacity}" IsScalar="True" X="{Binding OpacityDraft}"
              FieldKey="OpacityInput" XFieldKey="OpacityInput" ScalarInputName="OpacityInput" Minimum="0" Maximum="1" Increment="0.05"
              CanEdit="{Binding CanEditOpacity}" EditingHint="{Binding OpacityEditingHint}" IsAnimated="{Binding IsOpacityAnimated}"
              CanAddKeyframe="{Binding CanAddOpacityKeyframe}" CanReset="{Binding CanResetOpacityAnimation}"
              CommandParameter="{x:Static core:AnimationProperty.OPACITY}" AnimationOptionsCommand="{Binding AnimationOptionsPropertyCommand}"
              AnimationOptionsHint="{Loc Key=Workbench.OpacityAnimationOptions}" AddKeyframeCommand="{Binding AddPropertyKeyframeCommand}" KeyframeHint="{Loc Key=Workbench.Keyframe}"
              ResetCommand="{Binding ResetPropertyCommand}" ResetHint="{Loc Key=Workbench.ResetProperty}"
              Error="{Binding ValidationError}" InvalidFieldKey="{Binding InvalidFieldKey}" />
          <controlsCommon:PropertyRowControl Name="BlendRow" Header="{Loc Key=Workbench.Blend}">
            <ComboBox Name="BlendCombo" HorizontalAlignment="Stretch" SelectedIndex="{Binding Blend, Mode=TwoWay}" ItemsSource="{Binding Blends}" />
          </controlsCommon:PropertyRowControl>
          <controls:AnimationPropertyRowControl Name="BlurRow" Label="{Loc Key=Workbench.Blur}" IsScalar="True" X="{Binding BlurDraft}"
              FieldKey="BlurInput" XFieldKey="BlurInput" ScalarInputName="BlurInput" Minimum="0" Maximum="512" Increment="0.5"
              CanEdit="{Binding CanEditBlur}" EditingHint="{Binding BlurEditingHint}" IsAnimated="{Binding IsBlurAnimated}"
              CanAddKeyframe="{Binding CanAddBlurKeyframe}" CanReset="{Binding CanResetBlurAnimation}"
              CommandParameter="{x:Static core:AnimationProperty.BLUR}" AnimationOptionsCommand="{Binding AnimationOptionsPropertyCommand}"
              AnimationOptionsHint="{Loc Key=Workbench.BlurAnimationOptions}" AddKeyframeCommand="{Binding AddPropertyKeyframeCommand}" KeyframeHint="{Loc Key=Workbench.Keyframe}"
              ResetCommand="{Binding ResetPropertyCommand}" ResetHint="{Loc Key=Workbench.ResetProperty}"
              Error="{Binding ValidationError}" InvalidFieldKey="{Binding InvalidFieldKey}" />
        </StackPanel>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="MaskCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryMask}"
          IsExpanded="{Binding MaskExpanded, Mode=TwoWay}" IsVisible="{Binding HasEditableMask}">
        <StackPanel Spacing="4">
          <ItemsControl Name="EffectMaskRows" ItemsSource="{Binding MaskRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Loc Key=Workbench.MaskChooseNodeHint}" IsVisible="{Binding NeedsMaskNodeSelection}" TextWrapping="Wrap" />
          <Button Name="ClearMaskNodeAnimationButton"
              Command="{Binding ClearMaskNodeAnimationCommand}" IsEnabled="{Binding CanClearMaskNodeAnimation}"
              HorizontalAlignment="Left" ToolTip.Tip="{Loc Key=Workbench.MaskClearNodeAnimation}"
              AutomationProperties.Name="{Loc Key=Workbench.MaskClearNodeAnimation}">
            <controlsCommon:IconText IconKey="Reset" Text="{Loc Key=Workbench.MaskClearNodeAnimation}" />
          </Button>
        </StackPanel>
      </controlsCommon:PropertySection>
      <controlsCommon:PropertySection Name="PathCategory" Classes="effect-category" Header="{Loc Key=Workbench.EffectCategoryPath}" IsExpanded="{Binding PathExpanded, Mode=TwoWay}" IsVisible="{Binding IsWholeLayerTarget}">
        <StackPanel Spacing="4">
          <ItemsControl Name="PathPropertyRows" ItemsSource="{Binding PathRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:AnimationPropertyRowViewModel"><vm:EffectPropertyRowView DataContext="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
      <WrapPanel>
        <Button Name="PathButton" Command="{Binding PathCommand}">
          <controlsCommon:IconText IconKey="Path" Text="{Loc Key=Workbench.Path}" />
        </Button>
        <Button Name="AddPathPointButton" Command="{Binding AddPathPointCommand}">
          <controlsCommon:IconText IconKey="AddPathPoint" Text="{Loc Key=Workbench.AddPathPoint}" />
        </Button>
        <Button Name="RemovePathPointButton" Command="{Binding RemovePathPointCommand}">
          <controlsCommon:IconText IconKey="RemovePathPoint" Text="{Loc Key=Workbench.RemovePathPoint}" />
        </Button>
        <Button Name="ClearPathButton" Command="{Binding ClearPathCommand}">
          <controlsCommon:IconText IconKey="ClearPath" Text="{Loc Key=Workbench.ClearPath}" />
        </Button>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Name="OrientPathCheck" IsChecked="{Binding OrientPath, Mode=TwoWay}" Content="{Loc Key=Workbench.OrientPath}" />
      </StackPanel>
        </StackPanel>
      </controlsCommon:PropertySection>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
