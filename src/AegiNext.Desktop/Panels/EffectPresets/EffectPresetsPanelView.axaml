<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AegiNext.Desktop.Panels.EffectPresets" xmlns:common="using:AegiNext.Desktop.Controls.Common"
             x:Class="AegiNext.Desktop.Panels.EffectPresets.EffectPresetsPanelView" x:DataType="vm:EffectPresetsPanelViewModel"
             Classes="business-surface">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6" Margin="6">
    <WrapPanel>
      <Button Name="ApplyPresetButton" Command="{Binding ApplyCommand}" ToolTip.Tip="{Binding ApplyHint}"
              AutomationProperties.Name="{Loc Key=Workbench.ApplyPreset}">
        <common:IconText Text="{Loc Key=Workbench.ApplyPreset}" IconKey="ApplyPreset" />
      </Button>
      <Button Name="ManageEffectScriptsButton" Command="{Binding ManageEffectScriptsCommand}"
              AutomationProperties.Name="{Loc Key=Workbench.ManageEffectScripts}">
        <common:IconText Text="{Loc Key=Workbench.ManageEffectScripts}" IconKey="ManageEffectScripts" />
      </Button>
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding ApplyHint}" IsVisible="{Binding ShowApplyHint}" Classes="field" TextWrapping="Wrap" />
    <ListBox Grid.Row="2" Name="EffectPresetList" ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Loc Key=Layout.effectPresets}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><vm:EffectPresetGridPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </Grid>
</UserControl>
