<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:AegiNext.Desktop.Controls.Common"
        xmlns:editing="using:AegiNext.Desktop.Controls"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Styles.Resources>
    <ResourceDictionary>
    <sys:Double x:Key="WorkbenchControlHeight">32</sys:Double>
    <sys:Double x:Key="WorkbenchNumericMinimumWidth">48</sys:Double>
    <sys:Double x:Key="WorkbenchBodyFontSize">13</sys:Double>
    <sys:Double x:Key="WorkbenchInputLineHeight">20</sys:Double>
    <sys:Double x:Key="WorkbenchHeadingLineHeight">28</sys:Double>
    <FontFamily x:Key="WorkbenchBodyFontFamily">PingFang SC, Microsoft YaHei, Noto Sans CJK SC</FontFamily>
    <sys:Double x:Key="WorkbenchTabFontSize">13</sys:Double>
    <sys:Double x:Key="WorkbenchGapSmall">8</sys:Double>
    <sys:Double x:Key="WorkbenchGap">12</sys:Double>
    <Thickness x:Key="WorkbenchInset">12</Thickness>
    <Thickness x:Key="WorkbenchButtonPadding">12,6</Thickness>
    <CornerRadius x:Key="WorkbenchPanelCornerRadius">10</CornerRadius>
    <SolidColorBrush x:Key="WorkbenchDockActiveForeground" Color="{DynamicResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="WorkbenchDockTabSelectedBackground" Color="{DynamicResource SystemAccentColor}" Opacity="0.14"/>
    <SolidColorBrush x:Key="WorkbenchSectionHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.06"/>
    <ControlTheme x:Key="WorkbenchPropertySectionHeaderTheme" TargetType="ToggleButton">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Foreground" Value="{DynamicResource PreviewMuted}"/>
      <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="16,*" ColumnSpacing="4">
              <PathIcon Name="SectionChevron" Width="8" Height="8" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Data="M 2,0 L 6,4 L 2,8" RenderTransformOrigin="50%,50%"/>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Stretch"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSectionHover}"/>
      </Style>
      <Style Selector="^:checked /template/ PathIcon#SectionChevron">
        <Setter Property="RenderTransform"><RotateTransform Angle="90"/></Setter>
      </Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type common:PropertySection}" TargetType="common:PropertySection">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,Auto">
            <ToggleButton Name="PART_HeaderSite" Theme="{StaticResource WorkbenchPropertySectionHeaderTheme}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" IsVisible="{TemplateBinding IsExpanded}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="WorkbenchTransportSliderTheme" TargetType="Slider"
                  BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type common:ToolbarToggleButton}" TargetType="common:ToolbarToggleButton"
                  BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Width" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="MinWidth" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource WorkbenchDockTabSelectedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter, ^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[common:ToolbarToggleButton].Background}"/>
        <Setter Property="BorderBrush" Value="{Binding $parent[common:ToolbarToggleButton].BorderBrush}"/>
        <Setter Property="Foreground" Value="{Binding $parent[common:ToolbarToggleButton].Foreground}"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type common:SegmentedRadioButton}" TargetType="common:SegmentedRadioButton"
                  BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource PreviewBorder}"/>
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource WorkbenchDockTabSelectedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="WorkbenchDockChromeButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinWidth" Value="22"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource PreviewBorder}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource PreviewMuted}"/>
      </Style>
    </ControlTheme>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="PreviewBackground">#F2F4F8</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewSurface">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewBorder">#DDE2EA</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewMuted">#627087</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewError">#B42318</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchAppearanceInactive">#B45309</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchAppearanceActive">#15803D</SolidColorBrush>
      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="PreviewBackground">#12151C</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewSurface">#1C222D</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewBorder">#303949</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewMuted">#9AAAC2</SolidColorBrush>
        <SolidColorBrush x:Key="PreviewError">#FF9A9A</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchAppearanceInactive">#FBBF24</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchAppearanceActive">#4ADE80</SolidColorBrush>
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}"/><Setter Property="Background" Value="{DynamicResource PreviewBackground}"/></Style>
  <Style Selector="Window.business-surface, UserControl.business-surface">
    <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
  </Style>
  <Style Selector=".business-surface TextBox:not(.code-input):not(.multiline-input)">
    <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
    <Setter Property="LineHeight" Value="{StaticResource WorkbenchInputLineHeight}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector=".business-surface NumericUpDown /template/ TextBox, .business-surface AutoCompleteBox /template/ TextBox">
    <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
    <Setter Property="LineHeight" Value="{StaticResource WorkbenchInputLineHeight}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinWidth" Value="{StaticResource WorkbenchNumericMinimumWidth}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector=".business-surface TextBox.multiline-input">
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>
  <Style Selector=".business-surface TextBlock:not(.code-input):not(.multiline-input):not(.heading):not(.ui-icon)">
    <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
    <Setter Property="LineHeight" Value="{StaticResource WorkbenchInputLineHeight}"/>
  </Style>
  <Style Selector=".business-surface TextBlock.heading">
    <Setter Property="FontFamily" Value="{StaticResource WorkbenchBodyFontFamily}"/>
    <Setter Property="LineHeight" Value="{StaticResource WorkbenchHeadingLineHeight}"/>
  </Style>
  <Style Selector=".business-surface ComboBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector=".business-surface ToggleButton, .business-surface CheckBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:not(.dock-chrome)"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="{StaticResource WorkbenchButtonPadding}"/><Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}"/><Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="Button.icon-button, ToggleButton.icon-button">
    <Setter Property="Width" Value="{StaticResource WorkbenchControlHeight}"/>
    <Setter Property="Height" Value="{StaticResource WorkbenchControlHeight}"/>
    <Setter Property="MinWidth" Value="{StaticResource WorkbenchControlHeight}"/>
    <Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.animation-property-label">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.animation-property-action, ToggleButton.animation-property-action">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.icon-selector">
    <Setter Property="Width" Value="{DynamicResource WorkbenchControlHeight}"/>
    <Setter Property="Height" Value="{DynamicResource WorkbenchControlHeight}"/>
    <Setter Property="MinWidth" Value="{DynamicResource WorkbenchControlHeight}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBox.icon-selector /template/ PathIcon#DropDownGlyph">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ComboBox.icon-selector /template/ ContentControl#ContentPresenter">
    <Setter Property="Grid.ColumnSpan" Value="2"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="dock|ToolChromeControl">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CloseButtonTheme" Value="{StaticResource WorkbenchDockChromeButtonTheme}"/>
    <Setter Property="MaximizeButtonTheme" Value="{StaticResource WorkbenchDockChromeButtonTheme}"/>
    <Setter Property="PinButtonTheme" Value="{StaticResource WorkbenchDockChromeButtonTheme}"/>
    <Setter Property="MenuButtonTheme" Value="{StaticResource WorkbenchDockChromeButtonTheme}"/>
  </Style>
  <Style Selector="Border.workspace-frame">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource WorkbenchPanelCornerRadius}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
  </Style>
  <Style Selector="dock|ToolChromeControl:active /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource PreviewMuted}"/>
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource PreviewMuted}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
    </Setter>
  </Style>
  <Style Selector="dock|ToolChromeControl:active /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
  </Style>
  <Style Selector="dock|ToolChromeControl:active /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
  </Style>
  <Style Selector="dock|ToolControl /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="dock|ToolTabStrip">
    <Setter Property="Background" Value="{DynamicResource PreviewSurface}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="dock|ToolTabStrip /template/ Border#PART_BorderLeftFill, dock|ToolTabStrip /template/ Border#PART_BorderRightFill">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="dock|ToolTabStripItem">
    <Setter Property="Foreground" Value="{DynamicResource PreviewMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="dock|ToolTabStripItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PreviewBackground}"/>
  </Style>
  <Style Selector="dock|ToolTabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource WorkbenchDockActiveForeground}"/>
    <Setter Property="Background" Value="{DynamicResource WorkbenchDockTabSelectedBackground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="dock|ToolTabStripItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource WorkbenchDockTabSelectedBackground}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown, AutoCompleteBox"><Setter Property="MinHeight" Value="{StaticResource WorkbenchControlHeight}"/><Setter Property="FontSize" Value="{StaticResource WorkbenchBodyFontSize}"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="{StaticResource WorkbenchTabFontSize}"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style Selector="TextBlock.field"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource PreviewMuted}"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,4"/></Style>
  <Style Selector="WrapPanel &gt; Button"><Setter Property="Margin" Value="0,0,8,8"/></Style>
</Styles>
