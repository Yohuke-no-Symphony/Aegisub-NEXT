# Composition template: fixed slide/pop entry, flexible hold, and fixed slide/fade exit.
# Set short-clip to reject to explicitly reject clips shorter than 600ms.
effect "slide-pop" version 3
short-clip compress

scope whole current
    segment enter fixed 300ms
        at 0 position offset(-250, 0) ease-out
        at 0 scale factor(0.2, 0.2) ease-out
        at 0 opacity 0 ease-out
        at 0.7 scale factor(1.08, 1.08) ease-in-out
        at 1 position base
        at 1 scale base
        at 1 opacity base
    end

    segment stay flex 1
        at 0 position base hold
        at 0 scale base hold
        at 0 opacity base hold
        at 1 position base
        at 1 scale base
        at 1 opacity base
    end

    segment exit fixed 300ms
        at 0 position base ease-in
        at 0 opacity base ease-in
        at 1 position offset(250, 0)
        at 1 opacity 0
    end
end
